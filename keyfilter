package KeyFilter::Profile ;

use Cwd () ;
use File::Basename () ;
use File::Spec () ;

our $VERSION = '0.01' ;

my %STARTUP_COMMAND =
	(
	'startup-delay' => 1,
	'send-startup'  => 1,
	) ;

# -----------------------------------------------------------------------------

sub read_file
{
my ($path) = @_ ;

open(my $fh, '<', $path) or die "cannot read '$path': $!\n" ;

local $/ ;

my $text = <$fh> // '' ;

close $fh ;

return $text ;
}

# -----------------------------------------------------------------------------

sub read_commands
{
my ($path, $loaded) = @_ ;

my $canonical = Cwd::abs_path($path) ;

$loaded->{$canonical} = 1 ;

my @commands ;

for my $command (KeyFilter::Command::parse_commands(read_file($path), $path))
	{
	if ($command->{cmd} eq 'include')
		{
		push @commands, include_commands($command, $path, $loaded) ;
		}
	else
		{
		push @commands, $command ;
		}
	}

return @commands ;
}

# -----------------------------------------------------------------------------

sub include_commands
{
my ($command, $path, $loaded) = @_ ;

my $file = File::Spec->rel2abs($command->{file}, File::Basename::dirname($path)) ;

die "$command->{source}: missing include '$command->{file}'\n" unless -f $file ;

my $canonical = Cwd::abs_path($file) ;

return if $loaded->{$canonical} ;

return read_commands($file, $loaded) ;
}

# -----------------------------------------------------------------------------

sub load
{
my ($path, $loaded) = @_ ;

$loaded //= {} ;

die "missing profile '$path'\n" unless -f $path ;

my %profile =
	(
	name     => File::Basename::basename($path, '.profile'),
	path     => $path,
	commands => [ read_commands($path, $loaded) ],
	) ;

return bless \%profile, __PACKAGE__ ;
}

# -----------------------------------------------------------------------------

sub name { return $_[0]->{name} ; }

# -----------------------------------------------------------------------------

sub path { return $_[0]->{path} ; }

# -----------------------------------------------------------------------------

sub commands { return @{$_[0]->{commands}} ; }

# -----------------------------------------------------------------------------

sub rules
{
my ($self) = @_ ;

return KeyFilter::Rules->new()->add_commands($self->commands) ;
}

# -----------------------------------------------------------------------------

sub startup
{
my ($self) = @_ ;

return grep { exists $STARTUP_COMMAND{$_->{cmd}} } $self->commands ;
}

# -----------------------------------------------------------------------------

sub config_dir
{
my $home = $ENV{HOME} // die "HOME is not set\n" ;

return "$home/.config/keyfilter" ;
}

# -----------------------------------------------------------------------------

sub find_profile
{
my ($name) = @_ ;

my $path = index($name, '/') >= 0 ? $name : config_dir() . "/$name.profile" ;

return $path if -f $path ;

die "missing profile '$name', looked for '$path'\n" ;
}

# -----------------------------------------------------------------------------

sub load_profiles
{
my (@names) = @_ ;

my $loaded = {} ;

return map { load(find_profile($_), $loaded) } @names ;
}

# -----------------------------------------------------------------------------

sub build_rules
{
my (@profiles) = @_ ;

my $rules = KeyFilter::Rules->new() ;

$rules->add_commands($_->commands) for @profiles ;

return $rules ;
}

# -----------------------------------------------------------------------------

sub build_startup
{
my (@profiles) = @_ ;

return map { $_->startup } @profiles ;
}

# -----------------------------------------------------------------------------

package KeyFilter::Chain ;

use File::Basename () ;

our $VERSION = '0.01' ;

my $COMMAND_LINE = 'keyfilter_command_line' ;
my $RUNTIME      = 'keyfilter_runtime' ;

my %COMMAND_LINE_COMMAND =
	(
	block           => 1,
	unblock         => 1,
	map             => 1,
	'startup-delay' => 1,
	'send-startup'  => 1,
	) ;

my %CHAIN_STARTUP_NAME =
	(
	'startup-delay' => 1,
	'send-startup'  => 1,
	) ;

# -----------------------------------------------------------------------------

sub command_line_name { return $COMMAND_LINE ; }

# -----------------------------------------------------------------------------

sub runtime_name { return $RUNTIME ; }

# -----------------------------------------------------------------------------

sub new
{
my ($class, %arguments) = @_ ;

my @profiles     = @{$arguments{profiles} // []} ;
my @command_line = @{$arguments{command_line} // []} ;

for my $profile (@profiles)
	{
	die "not a profile\n" unless Scalar::Util::blessed($profile) && $profile->can('commands') && $profile->can('name') ;
	
	die "reserved profile name '" . $profile->name() . "'\n" if $profile->name() eq $COMMAND_LINE || $profile->name() eq $RUNTIME ;
	}

for my $command (@command_line)
	{
	my $name = ref($command) eq 'HASH' ? ($command->{cmd} // '') : '' ;
	
	die "not a command line command '$name'\n" unless $COMMAND_LINE_COMMAND{$name} ;
	}

my %self =
	(
	profiles     => \@profiles,
	active       => { map { $_->name() => 1 } @profiles },
	command_line => \@command_line,
	runtime      => [],
	generation   => 0,
	cache        => undef,
	) ;

return bless \%self, $class ;
}

# -----------------------------------------------------------------------------

sub profiles { return @{$_[0]->{profiles}} ; }

# -----------------------------------------------------------------------------

sub profile_names { return map { $_->name() } $_[0]->profiles() ; }

# -----------------------------------------------------------------------------

sub active_names
{
my ($self) = @_ ;

return grep { $self->{active}{$_} } $self->profile_names() ;
}

# -----------------------------------------------------------------------------

sub find_known
{
my ($self, $name) = @_ ;

my ($found) = grep { $_->name() eq $name } $self->profiles() ;

return $found ;
}

# -----------------------------------------------------------------------------

sub is_known { return $_[0]->find_known($_[1]) ? 1 : 0 ; }

# -----------------------------------------------------------------------------

sub is_active
{
my ($self, $name) = @_ ;

return $self->{active}{$name} ? 1 : 0 ;
}

# -----------------------------------------------------------------------------

sub active_profiles
{
my ($self) = @_ ;

return map { $self->find_known($_) } $self->active_names() ;
}

# -----------------------------------------------------------------------------

sub name_of
{
my ($argument) = @_ ;

return index($argument, '/') >= 0 ? File::Basename::basename($argument, '.profile') : $argument ;
}

# -----------------------------------------------------------------------------

sub enable
{
my ($self, $argument) = @_ ;

die "no profile name\n" unless defined $argument && length $argument ;

my $name = name_of($argument) ;

die "reserved profile name '$name'\n" if $name eq $COMMAND_LINE || $name eq $RUNTIME ;

if ($self->is_known($name))
	{
	return 0 if $self->is_active($name) ;
	
	$self->{active}{$name} = 1 ;
	
	$self->changed() ;
	
	return 1 ;
	}

my $profile = KeyFilter::Profile::load(KeyFilter::Profile::find_profile($argument), {}) ;

die "reserved profile name '" . $profile->name() . "'\n" if $profile->name() eq $COMMAND_LINE || $profile->name() eq $RUNTIME ;

push @{$self->{profiles}}, $profile ;

$self->{active}{$profile->name()} = 1 ;

$self->changed() ;

return 1 ;
}

# -----------------------------------------------------------------------------

sub disable
{
my ($self, $argument) = @_ ;

die "no profile name\n" unless defined $argument && length $argument ;

my $name = name_of($argument) ;

die "reserved profile name '$name'\n" if $name eq $COMMAND_LINE || $name eq $RUNTIME ;

return 0 unless $self->is_active($name) ;

delete $self->{active}{$name} ;

$self->changed() ;

return 1 ;
}

# -----------------------------------------------------------------------------

sub toggle
{
my ($self, $argument) = @_ ;

die "no profile name\n" unless defined $argument && length $argument ;

my $name = name_of($argument) ;

if ($self->is_active($name))
	{
	$self->disable($name) ;
	
	return 'disabled' ;
	}

$self->enable($argument) ;

return 'enabled' ;
}

# -----------------------------------------------------------------------------

sub command_line_commands { return @{$_[0]->{command_line}} ; }

# -----------------------------------------------------------------------------

sub runtime_commands { return @{$_[0]->{runtime}} ; }

# -----------------------------------------------------------------------------

sub order
{
my ($self) = @_ ;

return ($self->active_names(), $COMMAND_LINE, $RUNTIME) ;
}

# -----------------------------------------------------------------------------

sub add_runtime
{
my ($self, $command) = @_ ;

unless (KeyFilter::Rules::is_rule_command($command))
	{
	my $name = ref($command) eq 'HASH' ? ($command->{cmd} // '') : '' ;
	
	die "not a rule command '$name'\n" ;
	}

push @{$self->{runtime}}, $command ;

$self->changed() ;

return $self ;
}

# -----------------------------------------------------------------------------

sub commands
{
my ($self) = @_ ;

return ((map { $_->commands() } $self->active_profiles()), $self->command_line_commands(), $self->runtime_commands()) ;
}

# -----------------------------------------------------------------------------

sub generation { return $_[0]->{generation} ; }

#--#

sub changed
{
my ($self) = @_ ;

$self->{generation}++ ;
$self->{cache} = undef ;

return $self ;
}

#--#

sub rebuild
{
my ($self) = @_ ;

$self->changed() ;

return $self->rules() ;
}

#--#

sub rules
{
my ($self) = @_ ;

$self->{cache} //= KeyFilter::Rules->new()->add_commands($self->commands()) ;

return $self->{cache} ;
}

# -----------------------------------------------------------------------------

sub startup
{
my ($self) = @_ ;

return KeyFilter::Startup->new(grep { $CHAIN_STARTUP_NAME{$_->{cmd}} } (map { $_->commands() } $self->active_profiles()), $self->command_line_commands()) ;
}

# -----------------------------------------------------------------------------

package KeyFilter::PTY ;

use Fcntl () ;
use IO::Select () ;
use POSIX () ;
use Scalar::Util () ;
use Time::HiRes () ;

our $VERSION = '0.01' ;

my @RAW_MODES ;

my %APPLY_METHOD =
	(
	block   => 'apply_rule',
	unblock => 'apply_rule',
	map     => 'apply_rule',
	send    => 'apply_send',
	toggle  => 'apply_toggle',
	) ;

my %NEEDS_CHAIN =
	(
	block   => 1,
	unblock => 1,
	map     => 1,
	toggle  => 1,
	) ;

my %EVENT_METHOD =
	(
	C => 'child_exited',
	W => 'window_changed',
	) ;

END
	{
	restore_all() ;
	}

# -----------------------------------------------------------------------------

sub new
{
my ($class, %arguments) = @_ ;

my $command = $arguments{command} ;

die "no command to run\n" unless ref($command) eq 'ARRAY' && @$command && defined $command->[0] && length $command->[0] ;

pipe(my $wake_read, my $wake_write) or die "pipe: $!\n" ;

$wake_read->blocking(0) ;
$wake_write->blocking(0) ;

my %self =
	(
	command       => [ @$command ],
	input         => $arguments{input} // \*STDIN,
	output        => $arguments{output} // \*STDOUT,
	filter        => $arguments{filter},
	on_output     => $arguments{on_output},
	on_event      => $arguments{on_event},
	chain         => $arguments{chain},
	control       => $arguments{control},
	key_timeout   => $arguments{key_timeout} // 0.05,
	key_buffer    => '',
	key_deadline  => undef,
	command_errors => [],
	recorder      => $arguments{recorder},
	startup       => $arguments{startup},
	on_startup    => $arguments{on_startup},
	startup_fired => 0,
	spawned_at    => undef,
	wake_read     => $wake_read,
	wake_write    => $wake_write,
	signals       => {},
	pid           => undef,
	master        => undef,
	exit_code     => undef,
	pending_input => '',
	input_eof     => 0,
	last_sent     => '',
	raw           => undef,
	master_closed => 0,
	output_broken => 0,
	ran           => 0,
	) ;

return bless \%self, $class ;
}

# -----------------------------------------------------------------------------

sub pid { return $_[0]->{pid} ; }

# -----------------------------------------------------------------------------

sub master { return $_[0]->{master} ; }

# -----------------------------------------------------------------------------

sub exit_code { return $_[0]->{exit_code} ; }

# -----------------------------------------------------------------------------

sub input { return $_[0]->{input} ; }

# -----------------------------------------------------------------------------

sub input_eof { return $_[0]->{input_eof} ; }

# -----------------------------------------------------------------------------

sub pending_input { return length $_[0]->{pending_input} ; }

# -----------------------------------------------------------------------------

sub output { return $_[0]->{output} ; }

# -----------------------------------------------------------------------------

sub output_closed { return $_[0]->{master_closed} ; }

# -----------------------------------------------------------------------------

sub output_broken { return $_[0]->{output_broken} ; }

# -----------------------------------------------------------------------------

sub finished { return $_[0]->{master_closed} ; }

# -----------------------------------------------------------------------------

sub spawn
{
my ($self) = @_ ;

die "child already spawned\n" if defined $self->{pid} ;

require IO::Pty ;

my $master = IO::Pty->new() or die "cannot create a pty: $!\n" ;

copy_window_size($master, $self->{input}) ;

pipe(my $error_read, my $error_write) or die "pipe: $!\n" ;

my $pid = fork() ;

die "fork: $!\n" unless defined $pid ;

child_exec($master, $error_read, $error_write, @{$self->{command}}) if $pid == 0 ;

$master->close_slave() ;

close $error_write ;

my $error = '' ;

while (1)
	{
	my $count = sysread($error_read, my $chunk, 4096) ;
	
	if (!defined $count)
		{
		next if $!{EINTR} ;
		
		last ;
		}
	
	last if $count == 0 ;
	
	$error .= $chunk ;
	}

close $error_read ;

if (length $error)
	{
	waitpid($pid, 0) ;
	
	close $master ;
	
	die "cannot execute '$self->{command}[0]': $error\n" ;
	}

$master->blocking(0) ;

$self->{pid}        = $pid ;
$self->{master}     = $master ;
$self->{spawned_at} = monotonic() ;

return $pid ;
}

# -----------------------------------------------------------------------------

sub child_exec
{
my ($master, $error_read, $error_write, @command) = @_ ;

my $report = sub { syswrite($error_write, $_[0]) ; POSIX::_exit(127) ; } ;

close $error_read ;

$SIG{$_} = 'DEFAULT' for qw(INT QUIT TERM HUP PIPE CHLD WINCH TSTP TTIN TTOU CONT USR1 USR2 ALRM) ;

POSIX::setsid() or $report->("setsid: $!") ;

my $slave = $master->slave() or $report->("cannot open the pty slave: $!") ;

$master->make_slave_controlling_terminal() ;

close $master ;

open(STDIN, '<&', $slave) or $report->("cannot use the pty as stdin: $!") ;
open(STDOUT, '>&', $slave) or $report->("cannot use the pty as stdout: $!") ;
open(STDERR, '>&', $slave) or $report->("cannot use the pty as stderr: $!") ;

close $slave ;

{
no warnings 'exec' ;

exec { $command[0] } @command ;
}

$report->("$!") ;
}

# -----------------------------------------------------------------------------

sub reap
{
my ($self, $flags) = @_ ;

return 1 if defined $self->{exit_code} ;

die "child not spawned\n" unless defined $self->{pid} ;

my $result ;

while (1)
	{
	$result = waitpid($self->{pid}, $flags) ;
	
	last unless $result < 0 && $!{EINTR} ;
	}

return 0 if $result == 0 ;

my $status = $result < 0 ? 255 << 8 : $?  ;

$self->{exit_code} = $status & 127 ? 128 + ($status & 127) : $status >> 8 ;

return 1 ;
}

# -----------------------------------------------------------------------------

sub wait_exit
{
my ($self) = @_ ;

$self->reap(0) ;

return $self->{exit_code} ;
}

# -----------------------------------------------------------------------------

sub is_running
{
my ($self) = @_ ;

return 0 unless defined $self->{pid} ;

return $self->reap(POSIX::WNOHANG()) ? 0 : 1 ;
}

# -----------------------------------------------------------------------------

sub signal
{
my ($self, $name) = @_ ;

die "child not spawned\n" unless defined $self->{pid} ;

return kill $name, -$self->{pid} ;
}

# -----------------------------------------------------------------------------

sub close_master
{
my ($self) = @_ ;

close $self->{master} if defined $self->{master} && defined fileno($self->{master}) ;

return $self ;
}

# -----------------------------------------------------------------------------

sub enter_raw_mode
{
my ($fh) = @_ ;

return unless defined fileno($fh) && -t $fh ;

my $saved = POSIX::Termios->new() ;

$saved->getattr(fileno $fh) or return ;

my $raw = POSIX::Termios->new() ;

$raw->getattr(fileno $fh) or return ;

$raw->setiflag($raw->getiflag() & ~(POSIX::IGNBRK() | POSIX::BRKINT() | POSIX::PARMRK() | POSIX::ISTRIP() | POSIX::INLCR() | POSIX::IGNCR() | POSIX::ICRNL() | POSIX::IXON())) ;
$raw->setoflag($raw->getoflag() & ~POSIX::OPOST()) ;
$raw->setlflag($raw->getlflag() & ~(POSIX::ECHO() | POSIX::ECHONL() | POSIX::ICANON() | POSIX::ISIG() | POSIX::IEXTEN())) ;
$raw->setcflag(($raw->getcflag() & ~(POSIX::CSIZE() | POSIX::PARENB())) | POSIX::CS8()) ;
$raw->setcc(POSIX::VMIN(), 1) ;
$raw->setcc(POSIX::VTIME(), 0) ;

$raw->setattr(fileno $fh, POSIX::TCSANOW()) or return ;

my %state = (fh => $fh, termios => $saved, pid => $$, active => 1) ;

push @RAW_MODES, \%state ;

return \%state ;
}

# -----------------------------------------------------------------------------

sub leave_raw_mode
{
my ($state) = @_ ;

return unless $state ;

@RAW_MODES = grep { $_ != $state } @RAW_MODES ;

$state->{active} = 0 ;

return unless defined fileno($state->{fh}) ;

$state->{termios}->setattr(fileno $state->{fh}, POSIX::TCSANOW()) ;

return 1 ;
}

# -----------------------------------------------------------------------------

sub restore_all
{
leave_raw_mode($_) for grep { $_->{pid} == $$ } @RAW_MODES ;
}

# -----------------------------------------------------------------------------

sub raw_mode
{
my ($self) = @_ ;

return 1 if $self->{raw} && $self->{raw}{active} ;

$self->{raw} = enter_raw_mode($self->{input}) ;

return $self->{raw} ? 1 : 0 ;
}

# -----------------------------------------------------------------------------

sub restore_mode
{
my ($self) = @_ ;

leave_raw_mode(delete $self->{raw}) ;

return $self ;
}

# -----------------------------------------------------------------------------

sub rules { return $_[0]->{chain}->rules() ; }

# -----------------------------------------------------------------------------

sub filter_keys
{
my ($self, $data) = @_ ;

my $rules = $self->rules() ;

return $data if !length $self->{key_buffer} && !$rules->count() ;

$self->{key_buffer} .= $data ;

my ($keys, $rest) = KeyFilter::Key::split_keys($self->{key_buffer}) ;

$self->{key_buffer}   = $rest ;
$self->{key_deadline} = length $rest ? monotonic() + $self->{key_timeout} : undef ;

return $rules->process_keys(@$keys) ;
}

# -----------------------------------------------------------------------------

sub key_remaining
{
my ($self) = @_ ;

return undef unless defined $self->{key_deadline} ;

my $remaining = $self->{key_deadline} - monotonic() ;

return $remaining < 0 ? 0 : $remaining ;
}

# -----------------------------------------------------------------------------

sub flush_key_buffer
{
my ($self) = @_ ;

return 0 unless length $self->{key_buffer} ;

my @keys = KeyFilter::Key::flush_keys($self->{key_buffer}) ;

$self->{key_buffer}   = '' ;
$self->{key_deadline} = undef ;

$self->send_input($self->rules()->process_keys(@keys)) ;

return 1 ;
}

# -----------------------------------------------------------------------------

sub flush_keys_if_due
{
my ($self) = @_ ;

my $remaining = $self->key_remaining() ;

return 0 unless defined $remaining && $remaining <= 0 ;

return $self->flush_key_buffer() ;
}

# -----------------------------------------------------------------------------

sub command_errors { return @{$_[0]->{command_errors}} ; }

# -----------------------------------------------------------------------------

sub apply_command
{
my ($self, $command) = @_ ;

my $name   = ref($command) eq 'HASH' ? ($command->{cmd} // '') : '' ;
my $method = $APPLY_METHOD{$name} ;

if (!$method)
	{
	push @{$self->{command_errors}}, "the command '$name' is not supported" ;
	
	return 0 ;
	}

if (!$self->{chain} && $NEEDS_CHAIN{$name})
	{
	push @{$self->{command_errors}}, "the command '$name' needs a chain of profiles" ;
	
	return 0 ;
	}

my $applied = eval { $self->$method($command) ; 1 } ;

if (!$applied)
	{
	(my $message = $@) =~ s/\n\z// ;
	
	push @{$self->{command_errors}}, $message ;
	
	return 0 ;
	}

return 1 ;
}

# -----------------------------------------------------------------------------

sub apply_toggle
{
my ($self, $command) = @_ ;

$self->{chain}->toggle($command->{profile}) ;

return ;
}

# -----------------------------------------------------------------------------

sub apply_send
{
my ($self, $command) = @_ ;

$self->send_input($command->{text}) ;

return ;
}

# -----------------------------------------------------------------------------

sub apply_rule
{
my ($self, $command) = @_ ;

$self->{chain}->add_runtime($command) ;

return ;
}

# -----------------------------------------------------------------------------

sub service_control
{
my ($self, $fh) = @_ ;

my $applied = 0 ;

for my $command ($self->{control}->service($fh))
	{
	$self->apply_command($command) ;
	
	$applied++ ;
	}

return $applied ;
}

# -----------------------------------------------------------------------------

sub filter_input
{
my ($self, $data) = @_ ;

return $self->filter_keys($data) if $self->{chain} ;

return $data unless $self->{filter} ;

my $filtered = $self->{filter}->($data) ;

return defined $filtered ? $filtered : '' ;
}

# -----------------------------------------------------------------------------

sub send_input
{
my ($self, $data) = @_ ;

if (length $data)
	{
	$self->{pending_input} .= $data ;
	$self->{last_sent}      = substr($data, -1) ;
	
	$self->{recorder}->record_input($data) if $self->{recorder} ;
	}

return $self->flush_input() ;
}

# -----------------------------------------------------------------------------

sub flush_input
{
my ($self) = @_ ;

my $master = $self->{master} ;

return $self->pending_input() unless defined $master && defined fileno($master) ;

while (length $self->{pending_input})
	{
	my $written = syswrite($master, $self->{pending_input}) ;
	
	if (!defined $written)
		{
		last if $!{EAGAIN} || $!{EINTR} ;
		
		$self->{pending_input} = '' ;
		
		last ;
		}
	
	substr($self->{pending_input}, 0, $written, '') ;
	}

return $self->pending_input() ;
}

# -----------------------------------------------------------------------------

sub send_eof
{
my ($self) = @_ ;

my $eof       = "\x04" ;
my $canonical = 0 ;
my $master    = $self->{master} ;

if (defined $master && defined fileno($master))
	{
	my $termios = POSIX::Termios->new() ;
	
	if ($termios->getattr(fileno $master))
		{
		my $char = $termios->getcc(POSIX::VEOF()) ;
		
		$eof       = chr $char if $char ;
		$canonical = $termios->getlflag() & POSIX::ICANON() ;
		}
	}

my $partial = $canonical && length $self->{last_sent} && $self->{last_sent} ne "\n" ;

return $self->send_input($partial ? $eof x 2 : $eof) ;
}

# -----------------------------------------------------------------------------

sub forward_input
{
my ($self) = @_ ;

return 0 if $self->{input_eof} ;

my $count = sysread($self->{input}, my $data, 8192) ;

if (!defined $count)
	{
	return undef if $!{EAGAIN} || $!{EINTR} ;
	
	die "cannot read the input: $!\n" ;
	}

if ($count == 0)
	{
	$self->{input_eof} = 1 ;
	
	$self->flush_key_buffer() ;
	$self->send_eof() ;
	
	return 0 ;
	}

$self->send_input($self->filter_input($data)) ;

return $count ;
}

# -----------------------------------------------------------------------------

sub pump
{
my ($self, $timeout) = @_ ;

my $deadline = defined $timeout ? Time::HiRes::time() + $timeout : undef ;

while (1)
	{
	my @read = ($self->{wake_read}) ;
	
	push @read, $self->{input} unless $self->{input_eof} ;
	push @read, $self->{master} if defined $self->{master} && !$self->{master_closed} ;
	
	my @control = $self->{control} ? $self->{control}->handles() : () ;
	
	push @read, @control ;
	
	my @write = ($self->pending_input() && defined $self->{master}) ? ($self->{master}) : () ;
	
	my $remaining = defined $deadline ? $deadline - Time::HiRes::time() : undef ;
	
	$remaining = 0 if defined $remaining && $remaining < 0 ;
	
	my $due = $self->next_timer() ;
	
	$remaining = $due if defined $due && (!defined $remaining || $due < $remaining) ;
	
	$! = 0 ;
	
	my ($readable, $writable) = IO::Select->select(IO::Select->new(@read), IO::Select->new(@write), undef, $remaining) ;
	
	next if !$readable && $!{EINTR} ;
	
	my $events = 0 ;
	
	for my $fh (@{$readable // []})
		{
		if ($fh == $self->{wake_read})
			{
			$events += $self->dispatch_events() ;
			}
		elsif (defined $self->{master} && $fh == $self->{master})
			{
			$self->forward_output() ;
			
			$events++ ;
			}
		elsif (grep { $fh == $_ } @control)
			{
			$events += $self->service_control($fh) || 1 ;
			}
		else
			{
			$self->forward_input() ;
			
			$events++ ;
			}
		}
	
	for my $fh (@{$writable // []})
		{
		$self->flush_input() ;
		
		$events++ ;
		}
	
	$events += $self->fire_startup() ;
	$events += $self->flush_keys_if_due() ;
	
	return $events if $events ;
	
	my $waiting = $self->next_timer() ;
	
	next if defined $waiting && $waiting > 0 && (!defined $deadline || Time::HiRes::time() < $deadline) ;
	
	return 0 ;
	}
}

# -----------------------------------------------------------------------------

sub forward_output
{
my ($self) = @_ ;

my $count = sysread($self->{master}, my $data, 8192) ;

if (!defined $count)
	{
	return undef if $!{EAGAIN} || $!{EINTR} ;
	
	$self->{master_closed} = 1 ;
	
	return 0 ;
	}

if ($count == 0)
	{
	$self->{master_closed} = 1 ;
	
	return 0 ;
	}

$self->write_output($data) ;

return $count ;
}

# -----------------------------------------------------------------------------

sub write_output
{
my ($self, $data) = @_ ;

$self->{on_output}->($data) if $self->{on_output} ;
$self->{recorder}->record_output($data) if $self->{recorder} ;

return if $self->{output_broken} ;

local $SIG{PIPE} = 'IGNORE' ;

my $fh = $self->{output} ;

while (length $data)
	{
	my $written = syswrite($fh, $data) ;
	
	if (!defined $written)
		{
		next if $!{EINTR} ;
		
		if ($!{EAGAIN})
			{
			IO::Select->new($fh)->can_write(1) ;
			
			next ;
			}
		
		$self->{output_broken} = 1 ;
		
		return ;
		}
	
	substr($data, 0, $written, '') ;
	}
}

# -----------------------------------------------------------------------------

sub run
{
my ($self) = @_ ;

die "the command has already been run\n" if $self->{ran} ;

$self->{ran} = 1 ;

$self->spawn() ;

local $SIG{PIPE} = 'IGNORE' ;

$self->handle_signal(CHLD => 'C') ;
$self->handle_signal(WINCH => 'W') ;
$self->forward_signal($_) for qw(INT TERM QUIT HUP) ;
$self->wake('C') ;

$self->raw_mode() ;

my $ok    = eval { $self->pump(1) until $self->finished() ; 1 } ;
my $error = $@ ;

$self->restore_mode() ;

if (!$ok)
	{
	$self->close_master() ;
	$self->cleanup() ;
	
	die $error ;
	}

my $code = $self->wait_exit() ;

$self->{recorder}->record_exit($code) if $self->{recorder} ;

$self->close_master() ;
$self->cleanup() ;

return $code ;
}

# -----------------------------------------------------------------------------

sub wake
{
my ($self, $char) = @_ ;

return unless defined $self->{wake_write} && defined fileno($self->{wake_write}) ;

syswrite($self->{wake_write}, $char) ;

return ;
}

# -----------------------------------------------------------------------------

sub drain_events
{
my ($self) = @_ ;

return '' unless defined $self->{wake_read} && defined fileno($self->{wake_read}) ;

my $events = '' ;

while (1)
	{
	my $count = sysread($self->{wake_read}, my $chunk, 4096) ;
	
	last unless defined $count && $count > 0 ;
	
	$events .= $chunk ;
	}

return $events ;
}

# -----------------------------------------------------------------------------

sub dispatch_events
{
my ($self) = @_ ;

my @events = split //, $self->drain_events() ;

for my $event (@events)
	{
	$self->{on_event}->($event) if $self->{on_event} ;
	
	my $method = $EVENT_METHOD{$event} ;
	
	$self->$method() if $method ;
	}

return scalar @events ;
}

# -----------------------------------------------------------------------------

sub handle_signal
{
my ($self, $name, $char) = @_ ;

my $weak = $self ;

Scalar::Util::weaken($weak) ;

$self->{signals}{$name} = { previous => $SIG{$name} } unless exists $self->{signals}{$name} ;

$SIG{$name} = sub { $weak->wake($char) if $weak ; } ;

return $self ;
}

# -----------------------------------------------------------------------------

sub restore_signals
{
my ($self) = @_ ;

for my $name (keys %{$self->{signals}})
	{
	my $previous = delete $self->{signals}{$name} ;
	
	$SIG{$name} = defined $previous->{previous} ? $previous->{previous} : 'DEFAULT' ;
	}

return $self ;
}

# -----------------------------------------------------------------------------

sub cleanup
{
my ($self) = @_ ;

$self->restore_signals() ;

$self->{recorder}->close() if $self->{recorder} ;
$self->{control}->close() if $self->{control} ;

for my $name ('wake_read', 'wake_write')
	{
	close $self->{$name} if defined $self->{$name} && defined fileno($self->{$name}) ;
	}

return $self ;
}

# -----------------------------------------------------------------------------

sub child_exited
{
my ($self) = @_ ;

return 0 unless defined $self->{pid} && $self->reap(POSIX::WNOHANG()) ;

$self->drain_output() ;

$self->{master_closed} = 1 ;

return 1 ;
}

# -----------------------------------------------------------------------------

sub drain_output
{
my ($self) = @_ ;

return unless defined $self->{master} && defined fileno($self->{master}) ;

for (1 .. 256)
	{
	my $count = $self->forward_output() ;
	
	last unless $count ;
	}

return ;
}

# -----------------------------------------------------------------------------

sub forward_signal
{
my ($self, $name) = @_ ;

my $weak = $self ;

Scalar::Util::weaken($weak) ;

$self->{signals}{$name} = { previous => $SIG{$name} } unless exists $self->{signals}{$name} ;

$SIG{$name} = sub { $weak->signal($name) if $weak && defined $weak->{pid} && !defined $weak->{exit_code} ; } ;

return $self ;
}

# -----------------------------------------------------------------------------

sub copy_window_size
{
my ($master, $input) = @_ ;

return 0 unless defined $master && defined $input && defined fileno($input) && -t $input ;

return eval { $master->clone_winsize_from($input) ; 1 } ? 1 : 0 ;
}

# -----------------------------------------------------------------------------

sub sync_window_size
{
my ($self) = @_ ;

return copy_window_size($self->{master}, $self->{input}) ;
}

# -----------------------------------------------------------------------------

sub window_changed
{
my ($self) = @_ ;

return $self->sync_window_size() ;
}

# -----------------------------------------------------------------------------

sub monotonic { return Time::HiRes::clock_gettime(Time::HiRes::CLOCK_MONOTONIC()) ; }

# -----------------------------------------------------------------------------

sub next_timer
{
my ($self) = @_ ;

my @remaining = grep { defined } ($self->startup_remaining(), $self->key_remaining()) ;

return undef unless @remaining ;

my ($least) = sort { $a <=> $b } @remaining ;

return $least ;
}

# -----------------------------------------------------------------------------

sub startup_fired { return $_[0]->{startup_fired} ; }

# -----------------------------------------------------------------------------

sub startup_remaining
{
my ($self) = @_ ;

return undef unless defined $self->{startup} && !$self->{startup_fired} && defined $self->{spawned_at} ;

my $remaining = $self->{spawned_at} + $self->{startup}->delay_ms() / 1000 - monotonic() ;

return $remaining < 0 ? 0 : $remaining ;
}

# -----------------------------------------------------------------------------

sub fire_startup
{
my ($self) = @_ ;

my $remaining = $self->startup_remaining() ;

return 0 unless defined $remaining && $remaining <= 0 ;

$self->{startup_fired} = 1 ;

$self->send_input($_) for $self->{startup}->actions() ;

$self->{on_startup}->($self->{startup}) if $self->{on_startup} ;

return 1 ;
}

# -----------------------------------------------------------------------------

package KeyFilter::Discovery ;

use IO::Handle () ;
use IO::Select () ;

our $VERSION = '0.01' ;

# -----------------------------------------------------------------------------

sub hex_of
{
my ($bytes) = @_ ;

return join(' ', map { sprintf('%02x', ord) } split(//, $bytes)) ;
}

# -----------------------------------------------------------------------------

sub describe
{
my ($sequence, $eol) = @_ ;

$eol //= "\n" ;

my $name = KeyFilter::Key::name_of($sequence) // '(unknown)' ;

return "Key      : $name$eol" . 'Sequence : ' . hex_of($sequence) . "$eol$eol" ;
}

# -----------------------------------------------------------------------------

sub run
{
my (%arguments) = @_ ;

my $input   = $arguments{input} // \*STDIN ;
my $output  = $arguments{output} // \*STDOUT ;
my $error   = $arguments{error} // \*STDERR ;
my $timeout = $arguments{timeout} // 0.05 ;

my $raw = KeyFilter::PTY::enter_raw_mode($input) ;
my $eol = $raw ? "\r\n" : "\n" ;

$output->autoflush(1) ;
$error->autoflush(1) ;

print $error "Press keys to see what they send, Ctrl-C twice to stop.$eol" if $raw ;

my $select     = IO::Select->new($input) ;
my $buffer     = '' ;
my $interrupts = 0 ;
my $stop       = 0 ;

my $report = sub
	{
	for my $key (@_)
		{
		print $output describe($key, $eol) ;
		
		$interrupts = $key eq "\x03" ? $interrupts + 1 : 0 ;
		
		$stop = 1 if $interrupts >= 2 ;
		
		last if $stop ;
		}
	} ;

until ($stop)
	{
	my @ready = $select->can_read(length $buffer ? $timeout : undef) ;
	
	if (!@ready)
		{
		next unless length $buffer ;
		
		$report->(KeyFilter::Key::flush_keys($buffer)) ;
		
		$buffer = '' ;
		
		next ;
		}
	
	my $count = sysread($input, my $data, 4096) ;
	
	next if !defined $count && $!{EINTR} ;
	
	last if !defined $count ;
	
	if ($count == 0)
		{
		my ($keys, $rest) = KeyFilter::Key::split_keys($buffer) ;
		
		$report->(@$keys, KeyFilter::Key::flush_keys($rest)) ;
		
		last ;
		}
	
	$buffer .= $data ;
	
	my ($keys, $rest) = KeyFilter::Key::split_keys($buffer) ;
	
	$buffer = $rest ;
	
	$report->(@$keys) ;
	}

KeyFilter::PTY::leave_raw_mode($raw) ;

return 0 ;
}

