package KeyFilter::Recorder ;

use IO::Handle () ;
use Time::HiRes () ;

our $VERSION = '0.01' ;

my %ENCODE_ESCAPE =
	(
	"\\" => '\\\\',
	"\n" => '\n',
	"\r" => '\r',
	"\t" => '\t',
	"\e" => '\e',
	) ;

my %DECODE_ESCAPE =
	(
	'\\' => "\\",
	'n'  => "\n",
	'r'  => "\r",
	't'  => "\t",
	'e'  => "\e",
	) ;

# -----------------------------------------------------------------------------

sub monotonic_seconds { return Time::HiRes::clock_gettime(Time::HiRes::CLOCK_MONOTONIC()) ; }

# -----------------------------------------------------------------------------

sub encode
{
my ($bytes) = @_ ;

my $text = '' ;

for my $char (split //, $bytes)
	{
	my $code = ord $char ;
	
	if (exists $ENCODE_ESCAPE{$char})
		{
		$text .= $ENCODE_ESCAPE{$char} ;
		}
	elsif ($code >= 0x20 && $code <= 0x7e)
		{
		$text .= $char ;
		}
	else
		{
		$text .= sprintf('\x%02x', $code) ;
		}
	}

return $text ;
}

# -----------------------------------------------------------------------------

sub decode_escape
{
my ($hex, $char) = @_ ;

return chr hex $hex if defined $hex ;

die "trailing backslash in a recording\n" unless defined $char ;

die "unknown escape '\\$char' in a recording\n" unless exists $DECODE_ESCAPE{$char} ;

return $DECODE_ESCAPE{$char} ;
}

# -----------------------------------------------------------------------------

sub decode
{
my ($text) = @_ ;

$text =~ s{\\(?:x([0-9a-fA-F]{2})|(.)|\z)}{decode_escape($1, $2)}gse ;

return $text ;
}

# -----------------------------------------------------------------------------

sub new
{
my ($class, %arguments) = @_ ;

my ($handle, $owned) ;

if (defined $arguments{file})
	{
	open($handle, '>', $arguments{file}) or die "cannot write the recording '$arguments{file}': $!\n" ;
	
	$owned = 1 ;
	}
elsif (defined $arguments{handle})
	{
	$handle = $arguments{handle} ;
	}
else
	{
	die "a recording needs a file or a handle\n" ;
	}

binmode $handle ;

$handle->autoflush(1) ;

my $clock = $arguments{clock} // \&monotonic_seconds ;

my %self = (handle => $handle, owned => $owned, closed => 0, exited => 0, clock => $clock, start => $clock->(), last => 0) ;

my $self = bless \%self, $class ;

$self->write_line('# keyfilter-recording 1') ;

return $self ;
}

# -----------------------------------------------------------------------------

sub write_line
{
my ($self, $line) = @_ ;

return if $self->{closed} ;

print { $self->{handle} } "$line\n" ;

return ;
}

# -----------------------------------------------------------------------------

sub elapsed
{
my ($self) = @_ ;

my $elapsed = $self->{clock}->() - $self->{start} ;

$elapsed = $self->{last} if $elapsed < $self->{last} ;

$self->{last} = $elapsed ;

return sprintf('%.6f', $elapsed) ;
}

# -----------------------------------------------------------------------------

sub record
{
my ($self, $type, $bytes) = @_ ;

return unless defined $bytes && length $bytes ;

return if $self->{exited} ;

$self->write_line($self->elapsed() . " $type " . encode($bytes)) ;

return ;
}

# -----------------------------------------------------------------------------

sub record_exit
{
my ($self, $code) = @_ ;

die "invalid exit code '" . ($code // '') . "'\n" unless defined $code && $code =~ /\A\d+\z/ && $code <= 255 ;

return if $self->{exited} || $self->{closed} ;

$self->{exited} = 1 ;

$self->write_line($self->elapsed() . " X $code") ;

return ;
}

# -----------------------------------------------------------------------------

sub record_input { my ($self, $bytes) = @_ ; return $self->record('I', $bytes) ; }

# -----------------------------------------------------------------------------

sub record_output { my ($self, $bytes) = @_ ; return $self->record('O', $bytes) ; }

# -----------------------------------------------------------------------------

sub close
{
my ($self) = @_ ;

return $self if $self->{closed} ;

$self->{closed} = 1 ;

if ($self->{owned})
	{
	CORE::close($self->{handle}) ;
	}
else
	{
	$self->{handle}->flush() ;
	}

return $self ;
}

# -----------------------------------------------------------------------------

sub parse_recording
{
my ($text) = @_ ;

my @events ;
my $number = 0 ;
my $last   = 0 ;
my $exited = 0 ;

for my $line (split /\n/, $text)
	{
	$number++ ;
	
	next if $line =~ /\A#/ || $line =~ /\A\s*\z/ ;
	
	die "recording line $number: invalid event\n" unless $line =~ /\A(\d+\.\d{6}) ([IOX]) ?(.*)\z/ ;
	
	my ($time, $type, $payload) = ($1, $2, $3) ;
	
	die "recording line $number: the time goes back\n" if $time < $last ;
	die "recording line $number: an event after the exit code\n" if $exited ;
	
	$last = $time ;
	
	if ($type eq 'X')
		{
		die "recording line $number: invalid exit code\n" unless $payload =~ /\A\d+\z/ && $payload <= 255 ;
		
		$exited = 1 ;
		
		push @events, { time => $time + 0, type => 'X', code => $payload + 0 } ;
		
		next ;
		}
	
	my $data = eval { decode($payload) ; } ;
	
	die "recording line $number: $@" if $@ ;
	
	push @events, { time => $time + 0, type => $type, data => $data } ;
	}

return @events ;
}

# -----------------------------------------------------------------------------

sub exit_code_of
{
my (@events) = @_ ;

my ($exit) = grep { $_->{type} eq 'X' } @events ;

return $exit ? $exit->{code} : undef ;
}

