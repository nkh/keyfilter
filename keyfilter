package KeyFilter::Startup ;

use Scalar::Util () ;

our $VERSION = '0.01' ;

my %STARTUP_NAME =
	(
	'startup-delay' => 1,
	'send-startup'  => 1,
	) ;

# -----------------------------------------------------------------------------

sub new
{
my ($class, @commands) = @_ ;

my $delay = 0 ;
my @actions ;

for my $command (@commands)
	{
	my $name = ref($command) eq 'HASH' ? ($command->{cmd} // '') : '' ;
	
	die "not a startup command '$name'\n" unless $STARTUP_NAME{$name} ;
	
	$delay = $command->{ms} if $name eq 'startup-delay' ;
	
	push @actions, $command->{text} if $name eq 'send-startup' ;
	}

return bless { delay_ms => $delay, actions => \@actions }, $class ;
}

# -----------------------------------------------------------------------------

sub from_profiles
{
my ($class, @profiles) = @_ ;

for my $profile (@profiles)
	{
	die "not a profile\n" unless Scalar::Util::blessed($profile) && $profile->can('startup') ;
	}

return $class->new(KeyFilter::Profile::build_startup(@profiles)) ;
}

# -----------------------------------------------------------------------------

sub delay_ms { return $_[0]->{delay_ms} ; }

#--#

sub actions { return @{$_[0]->{actions}} ; }

#--#

sub text { return join('', $_[0]->actions()) ; }

