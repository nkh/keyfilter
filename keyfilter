package KeyFilter::Replayer ;

use Time::HiRes () ;

our $VERSION = '0.01' ;

# -----------------------------------------------------------------------------

sub new
{
my ($class, %arguments) = @_ ;

my $text ;

if (defined $arguments{file})
	{
	open(my $fh, '<', $arguments{file}) or die "cannot read the recording '$arguments{file}': $!\n" ;
	
	binmode $fh ;
	
	local $/ ;
	
	$text = <$fh> // '' ;
	
	close $fh ;
	}
elsif (defined $arguments{text})
	{
	$text = $arguments{text} ;
	}
else
	{
	die "a replay needs a recording\n" ;
	}

my @events = eval { KeyFilter::Recorder::parse_recording($text) ; } ;

die defined $arguments{file} ? "$arguments{file}: $@" : $@ if $@ ;

my %self =
	(
	events => \@events,
	output => $arguments{output} // \*STDOUT,
	fast   => $arguments{fast} ? 1 : 0,
	clock  => $arguments{clock} // \&KeyFilter::Recorder::monotonic_seconds,
	sleep  => $arguments{sleep} // sub { Time::HiRes::sleep($_[0]) ; },
	broken => 0,
	) ;

return bless \%self, $class ;
}

# -----------------------------------------------------------------------------

sub events { return @{$_[0]->{events}} ; }

# -----------------------------------------------------------------------------

sub exit_code { return KeyFilter::Recorder::exit_code_of($_[0]->events()) // 0 ; }

# -----------------------------------------------------------------------------

sub wait_until
{
my ($self, $time, $start) = @_ ;

while (1)
	{
	my $remaining = $time - ($self->{clock}->() - $start) ;
	
	last unless $remaining > 0 ;
	
	$self->{sleep}->($remaining) ;
	}

return ;
}

# -----------------------------------------------------------------------------

sub write_output
{
my ($self, $data) = @_ ;

my $fh = $self->{output} ;

while (length $data)
	{
	my $written = syswrite($fh, $data) ;
	
	if (!defined $written)
		{
		next if $!{EINTR} ;
		
		if ($!{EAGAIN})
			{
			IO::Select->new($fh)->can_write(1) ;
			
			next ;
			}
		
		$self->{broken} = 1 ;
		
		return ;
		}
	
	substr($data, 0, $written, '') ;
	}

return ;
}

# -----------------------------------------------------------------------------

sub run
{
my ($self) = @_ ;

local $SIG{PIPE} = 'IGNORE' ;

my $start = $self->{clock}->() ;

for my $event ($self->events())
	{
	$self->wait_until($event->{time}, $start) unless $self->{fast} ;
	
	$self->write_output($event->{data}) if $event->{type} eq 'O' ;
	
	last if $self->{broken} ;
	}

return $self->exit_code() ;
}

