package KeyFilter::Control ;

use File::Path () ;
use IO::Socket::UNIX () ;
use Socket () ;

our $VERSION = '0.01' ;

my $MAXIMUM_PATH = 100 ;
my $MAXIMUM_LINE = 65536 ;

my %RUNTIME_COMMAND =
	(
	block   => 1,
	unblock => 1,
	map     => 1,
	toggle  => 1,
	send    => 1,
	) ;

# -----------------------------------------------------------------------------

sub socket_dir
{
my $home = $ENV{HOME} // die "HOME is not set\n" ;

return "$home/.config/keyfilter/sockets" ;
}

# -----------------------------------------------------------------------------

sub new
{
my ($class, %arguments) = @_ ;

my $dir  = $arguments{dir} // socket_dir() ;
my $pid  = $arguments{pid} // $$ ;
my $path = "$dir/$pid.sock" ;

die "the socket path '$path' is too long\n" if length $path > $MAXIMUM_PATH ;

if (!-d $dir)
	{
	File::Path::make_path($dir, { mode => 0700, error => \my $errors }) ;
	
	if ($errors && @$errors)
		{
		my ($file, $message) = %{$errors->[0]} ;
		
		die "cannot create the socket directory '$dir': $message\n" ;
		}
	}

unlink $path if -e $path || -l $path ;

my $listener = IO::Socket::UNIX->new(Local => $path, Listen => 16, Type => Socket::SOCK_STREAM()) or die "cannot create the socket '$path': $!\n" ;

chmod 0600, $path ;

$listener->blocking(0) ;

my %self =
	(
	dir       => $dir,
	pid       => $pid,
	path      => $path,
	info_path => "$dir/$pid.info",
	listener  => $listener,
	closed    => 0,
	clients   => {},
	errors    => [],
	) ;

my $self = bless \%self, $class ;

$self->write_info($arguments{info}) if $arguments{info} ;

return $self ;
}

# -----------------------------------------------------------------------------

sub write_info
{
my ($self, $info) = @_ ;

my $text = '' ;

for my $key (sort keys %$info)
	{
	my $value = $info->{$key} // '' ;
	
	$value =~ s/[\x00-\x1f\x7f]+/ /g ;
	
	$text .= "$key: $value\n" ;
	}

open(my $fh, '>', $self->{info_path}) or die "cannot write '$self->{info_path}': $!\n" ;

print $fh $text ;

CORE::close($fh) or die "cannot write '$self->{info_path}': $!\n" ;

chmod 0600, $self->{info_path} ;

return $self ;
}

# -----------------------------------------------------------------------------

sub info_path { return $_[0]->{info_path} ; }

# -----------------------------------------------------------------------------

sub dir { return $_[0]->{dir} ; }

# -----------------------------------------------------------------------------

sub pid { return $_[0]->{pid} ; }

# -----------------------------------------------------------------------------

sub path { return $_[0]->{path} ; }

# -----------------------------------------------------------------------------

sub listener { return $_[0]->{listener} ; }

# -----------------------------------------------------------------------------

sub accept
{
my ($self) = @_ ;

return undef if $self->{closed} ;

return $self->{listener}->accept() ;
}

# -----------------------------------------------------------------------------

sub parse_line
{
my ($line) = @_ ;

my $command = KeyFilter::Command::parse_command($line) ;

return undef unless $command ;

die "the command '$command->{cmd}' is not allowed at runtime\n" unless $RUNTIME_COMMAND{$command->{cmd}} ;

return $command ;
}

# -----------------------------------------------------------------------------

sub errors { return map { { %$_ } } @{$_[0]->{errors}} ; }

# -----------------------------------------------------------------------------

sub clear_errors
{
my ($self) = @_ ;

$self->{errors} = [] ;

return $self ;
}

# -----------------------------------------------------------------------------

sub client_count { return scalar keys %{$_[0]->{clients}} ; }

# -----------------------------------------------------------------------------

sub handles
{
my ($self) = @_ ;

return () if $self->{closed} ;

return ($self->{listener}, map { $self->{clients}{$_}{fh} } sort { $a <=> $b } keys %{$self->{clients}}) ;
}

# -----------------------------------------------------------------------------

sub accept_clients
{
my ($self) = @_ ;

while (my $fh = $self->accept())
	{
	$fh->blocking(0) ;
	
	$self->{clients}{fileno $fh} = { fh => $fh, buffer => '' } ;
	}

return ;
}

# -----------------------------------------------------------------------------

sub drop_client
{
my ($self, $number) = @_ ;

my $client = delete $self->{clients}{$number} ;

CORE::close($client->{fh}) if $client ;

return ;
}

# -----------------------------------------------------------------------------

sub handle_line
{
my ($self, $line) = @_ ;

my $command = eval { parse_line($line) ; } ;

if ($@)
	{
	(my $message = $@) =~ s/\n\z// ;
	
	push @{$self->{errors}}, { line => $line, error => $message } ;
	
	return () ;
	}

return defined $command ? ($command) : () ;
}

# -----------------------------------------------------------------------------

sub service
{
my ($self, $fh) = @_ ;

return () if $self->{closed} || !defined $fh ;

if ($fh == $self->{listener})
	{
	$self->accept_clients() ;
	
	return () ;
	}

my $number = defined fileno($fh) ? fileno($fh) : undef ;

return () unless defined $number && exists $self->{clients}{$number} && $self->{clients}{$number}{fh} == $fh ;

my $client = $self->{clients}{$number} ;
my $count  = sysread($fh, my $data, 4096) ;

if (!defined $count)
	{
	return () if $!{EAGAIN} || $!{EINTR} ;
	
	$self->drop_client($number) ;
	
	return () ;
	}

my @commands ;

if ($count == 0)
	{
	push @commands, $self->handle_line($client->{buffer}) if length $client->{buffer} ;
	
	$self->drop_client($number) ;
	
	return @commands ;
	}

$client->{buffer} .= $data ;

while ($client->{buffer} =~ s/\A([^\n]*)\n//)
	{
	(my $line = $1) =~ s/\r\z// ;
	
	push @commands, $self->handle_line($line) ;
	}

if (length $client->{buffer} > $MAXIMUM_LINE)
	{
	push @{$self->{errors}}, { line => '', error => 'line too long' } ;
	
	$self->drop_client($number) ;
	}

return @commands ;
}

# -----------------------------------------------------------------------------

sub close
{
my ($self) = @_ ;

return $self if $self->{closed} ;

$self->{closed} = 1 ;

CORE::close($self->{listener}) ;

CORE::close($_->{fh}) for values %{$self->{clients}} ;

$self->{clients} = {} ;

unlink $self->{path}, $self->{info_path} ;

return $self ;
}

# -----------------------------------------------------------------------------

sub pid_alive
{
my ($pid) = @_ ;

return 0 unless defined $pid && $pid =~ /\A\d+\z/ && $pid > 0 ;

return 0 unless kill(0, $pid) || $!{EPERM} ;

if (open(my $fh, '<', "/proc/$pid/stat"))
	{
	my $stat = <$fh> // '' ;
	
	CORE::close($fh) ;
	
	return 0 if $stat =~ /\) Z / ;
	}

return 1 ;
}

# -----------------------------------------------------------------------------

sub read_info
{
my ($path) = @_ ;

return {} unless open(my $fh, '<', $path) ;

my %info ;

while (my $line = <$fh>)
	{
	$line =~ s/\r?\n\z// ;
	
	$info{$1} = $2 if $line =~ /\A([A-Za-z_][\w-]*):[ \t]*(.*?)[ \t]*\z/ ;
	}

CORE::close($fh) ;

return \%info ;
}

# -----------------------------------------------------------------------------

sub instances
{
my ($dir) = @_ ;

$dir //= socket_dir() ;

return () unless opendir(my $handle, $dir) ;

my @names = grep { /\A\d+\.sock\z/ } readdir $handle ;

closedir $handle ;

my @instances ;

for my $name (sort { ($a =~ /(\d+)/)[0] <=> ($b =~ /(\d+)/)[0] } @names)
	{
	my ($pid) = $name =~ /\A(\d+)\.sock\z/ ;
	
	next unless -S "$dir/$name" && pid_alive($pid) ;
	
	push @instances, { pid => $pid + 0, socket => "$dir/$name", info => read_info("$dir/$pid.info") } ;
	}

return @instances ;
}

# -----------------------------------------------------------------------------

sub instance
{
my ($pid, $dir) = @_ ;

return undef unless defined $pid && $pid =~ /\A\d+\z/ ;

my ($found) = grep { $_->{pid} == $pid } instances($dir) ;

return $found ;
}

# -----------------------------------------------------------------------------

sub remove_stale
{
my ($dir) = @_ ;

$dir //= socket_dir() ;

return () unless opendir(my $handle, $dir) ;

my @names = grep { /\A\d+\.(?:sock|info)\z/ } readdir $handle ;

closedir $handle ;

my %stale ;

for my $name (@names)
	{
	my ($pid) = $name =~ /\A(\d+)\./ ;
	
	next if pid_alive($pid) ;
	
	unlink "$dir/$name" ;
	
	$stale{$pid + 0} = 1 ;
	}

return sort { $a <=> $b } keys %stale ;
}

# -----------------------------------------------------------------------------

package KeyFilter::Ctl ;

use IO::Socket::UNIX () ;
use Socket () ;

our $VERSION = '0.01' ;

my %COMMAND =
	(
	ls   => 'command_ls',
	send => 'command_send',
	toggle  => 'command_toggle',
	block   => 'command_block',
	unblock => 'command_unblock',
	map     => 'command_map',
	) ;

my $CTL_MAXIMUM_LINE = 65536 ;

# -----------------------------------------------------------------------------

sub usage
{
return "Usage: keyfilterctl [--pid PID] command [arguments]\nTry 'keyfilterctl --help' for more information.\n" ;
}

# -----------------------------------------------------------------------------

sub help_text
{
return <<'HELP' ;
Usage: keyfilterctl [--pid PID] command [arguments]
       keyfilterctl -h | --help

Control the keyfilter instances that are running for the current user.

Commands:
  ls                      list the instances, one per line: the pid and the command
  send TEXT               send the text to the command of the instance
  toggle PROFILE          turn a profile of the instance on or off
  block KEYS              block keys
  unblock KEYS            unblock keys
  map KEY=REPLACEMENT     replace a key by text and keys

Options:
  -p, --pid PID           the instance to talk to, when there are several
  -h, --help              show this help

Instances are found by their sockets in ~/.config/keyfilter/sockets.
See keyfilterctl(1).
HELP
}

# -----------------------------------------------------------------------------

sub choose_instance
{
my ($out, $err, $dir, $pid) = @_ ;

if (defined $pid)
	{
	my $instance = KeyFilter::Control::instance($pid, $dir) ;
	
	return $instance if $instance ;
	
	print $err "keyfilterctl: no keyfilter instance has the pid $pid\n" ;
	
	return undef ;
	}

my @instances = KeyFilter::Control::instances($dir) ;

if (!@instances)
	{
	print $err "keyfilterctl: no keyfilter instance is running\n" ;
	
	return undef ;
	}

if (@instances > 1)
	{
	print $err "keyfilterctl: several keyfilter instances are running (pids " . join(', ', map { $_->{pid} } @instances) . "), choose one with --pid\n" ;
	
	return undef ;
	}

return $instances[0] ;
}

# -----------------------------------------------------------------------------

sub deliver
{
my ($line, $out, $err, $dir, $pid) = @_ ;

my $instance = choose_instance($out, $err, $dir, $pid) or return 2 ;

local $SIG{PIPE} = 'IGNORE' ;

my $socket = IO::Socket::UNIX->new(Peer => $instance->{socket}, Type => Socket::SOCK_STREAM()) ;

if (!$socket)
	{
	print $err "keyfilterctl: cannot connect to the instance $instance->{pid}: $!\n" ;
	
	return 2 ;
	}

my $data = "$line\n" ;

while (length $data)
	{
	my $written = syswrite($socket, $data) ;
	
	if (!defined $written)
		{
		next if $!{EINTR} ;
		
		print $err "keyfilterctl: cannot write to the instance $instance->{pid}: $!\n" ;
		
		return 2 ;
		}
	
	substr($data, 0, $written, '') ;
	}

close $socket ;

return 0 ;
}

# -----------------------------------------------------------------------------

sub check_line
{
my ($line, $err) = @_ ;

if ($line =~ /[\r\n]/)
	{
	print $err "keyfilterctl: the text cannot contain a line end, write \\n\n" ;
	
	return 0 ;
	}

if (length $line >= $CTL_MAXIMUM_LINE)
	{
	print $err "keyfilterctl: the command is too long\n" ;
	
	return 0 ;
	}

my $command = eval { KeyFilter::Control::parse_line($line) ; } ;

if ($@)
	{
	print $err "keyfilterctl: $@" ;
	
	return 0 ;
	}

return $command ? 1 : 0 ;
}

# -----------------------------------------------------------------------------

sub command_send
{
my ($arguments, $out, $err, $dir, $pid) = @_ ;

my $text = join(' ', @$arguments) ;

if (!length $text)
	{
	print $err "keyfilterctl: send requires text\n" ;
	
	return 1 ;
	}

my $line = "send $text" ;

return 1 unless check_line($line, $err) ;

return deliver($line, $out, $err, $dir, $pid) ;
}

# -----------------------------------------------------------------------------

sub rule_command
{
my ($name, $arguments, $out, $err, $dir, $pid) = @_ ;

my $text = join(' ', @$arguments) ;

if ($text !~ /\S/)
	{
	print $err "keyfilterctl: $name requires an argument\n" ;
	
	return 1 ;
	}

my $line = "$name $text" ;

return 1 unless check_line($line, $err) ;

return deliver($line, $out, $err, $dir, $pid) ;
}

# -----------------------------------------------------------------------------

sub command_block { return rule_command('block', @_) ; }

# -----------------------------------------------------------------------------

sub command_unblock { return rule_command('unblock', @_) ; }

# -----------------------------------------------------------------------------

sub command_map { return rule_command('map', @_) ; }

# -----------------------------------------------------------------------------

sub command_toggle
{
my ($arguments, $out, $err, $dir, $pid) = @_ ;

if (@$arguments != 1 || !length $arguments->[0])
	{
	print $err "keyfilterctl: toggle takes one profile name\n" ;
	
	return 1 ;
	}

my $name = $arguments->[0] ;

if ($name =~ /[\s#]/)
	{
	print $err "keyfilterctl: a profile name cannot contain a space or a #\n" ;
	
	return 1 ;
	}

if ($name eq KeyFilter::Chain::runtime_name() || $name eq KeyFilter::Chain::command_line_name())
	{
	print $err "keyfilterctl: reserved profile name '$name'\n" ;
	
	return 1 ;
	}

my $line = "toggle $name" ;

return 1 unless check_line($line, $err) ;

return deliver($line, $out, $err, $dir, $pid) ;
}

# -----------------------------------------------------------------------------

sub command_ls
{
my ($arguments, $out, $err, $dir) = @_ ;

if (@$arguments)
	{
	print $err "keyfilterctl: ls takes no argument\n" ;
	
	return 1 ;
	}

for my $instance (KeyFilter::Control::instances($dir))
	{
	print $out "$instance->{pid} " . ($instance->{info}{command} // '(unknown)') . "\n" ;
	}

return 0 ;
}

# -----------------------------------------------------------------------------

sub run
{
my (%arguments) = @_ ;

my @argv = @{$arguments{argv} // []} ;
my $out  = $arguments{stdout} // \*STDOUT ;
my $err  = $arguments{stderr} // \*STDERR ;
my $dir  = $arguments{dir} ;

my $pid ;

while (@argv && $argv[0] =~ /\A-/)
	{
	my $option = shift @argv ;
	
	if ($option eq '-h' || $option eq '--help')
		{
		print $out help_text() ;
		
		return 0 ;
		}
	
	if ($option eq '--')
		{
		last ;
		}
	
	if ($option eq '-p' || $option eq '--pid' || $option =~ /\A--pid=/)
		{
		my ($value) = $option =~ /\A--pid=(.*)\z/s ;
		
		$value = shift @argv unless defined $value ;
		
		if (!defined $value || $value !~ /\A\d+\z/ || $value == 0)
			{
			print $err "keyfilterctl: option '--pid' needs a pid\n" ;
			
			return 1 ;
			}
		
		$pid = $value + 0 ;
		
		next ;
		}
	
	print $err "keyfilterctl: unknown option '$option'\n" ;
	
	return 1 ;
	}

if (!@argv)
	{
	print $err usage() ;
	
	return 1 ;
	}

my $name   = shift @argv ;
my $method = $COMMAND{$name} ;

if (!$method)
	{
	print $err "keyfilterctl: unknown command '$name'\n" ;
	
	return 1 ;
	}

no strict 'refs' ;

return &{$method}(\@argv, $out, $err, $dir, $pid) ;
}

# -----------------------------------------------------------------------------

package KeyFilter::CLI ;

use File::Basename () ;

our $VERSION = '0.01' ;

my %FLAG_OPTION =
	(
	'--discover'  => 'discover',
	'--fast'      => 'fast',
	'--help'      => 'help',
	'--version'   => 'version',
	'--no-socket' => 'no_socket',
	) ;

my %VALUE_OPTION =
	(
	'--replay'  => 'replay',
	'--record'  => 'record',
	'--profile' => 'profile',
	) ;

my %COMMAND_OPTION =
	(
	'--block'         => 'block',
	'--unblock'       => 'unblock',
	'--map'           => 'map',
	'--startup-delay' => 'startup-delay',
	'--send-startup'  => 'send-startup',
	) ;

#--#

sub usage
{
return "Usage: keyfilter [options] -- command [args...]\nTry 'keyfilter --help' for more information.\n" ;
}

#--#

sub help_text
{
return <<'HELP' ;
Usage: keyfilter [options] [--] command [args...]
       keyfilter --discover
       keyfilter --replay FILE [--fast]
       keyfilter -h | --help | --version

Run a command in a pseudo terminal and filter the keys typed to it.

Rules, each can be given several times, they apply in the order given:
      --block KEYS            block the keys
      --unblock KEYS          unblock the keys
      --map KEY=REPLACEMENT   replace a key by text and keys
      --profile NAME          load a profile, a name or a path

Startup:
      --startup-delay MS      wait this many milliseconds, then
      --send-startup TEXT     send the text to the command

Recording:
      --record FILE           record the session in FILE
      --replay FILE           replay a recording
      --fast                  replay without the recorded pauses

Other:
      --discover              show what the keys of the terminal send
      --no-socket             do not create the control socket
  -h, --help                  show this help
      --version               show the version

Keys are written a, C-a, M-a, S-Tab, C-M-Up, F5, Enter, Esc, Space, or as
hexadecimal bytes such as 1b5b41. A replacement is text, with \n, \t, \e,
\\, \#, \xHH, and keys between << and >>, for example <<Enter>>.

Examples:
  keyfilter --block C-z -- bash
  keyfilter --map M-b=<<C-t>> -- bash
  keyfilter --map F5='git status\n' -- bash
  keyfilter --profile common --profile vim -- vim
  keyfilter --startup-delay 500 --send-startup 'source env.sh\n' -- bash

A running instance is controlled with keyfilterctl, see keyfilterctl --help.
Profiles are in ~/.config/keyfilter, sockets in ~/.config/keyfilter/sockets.
See keyfilter(1) for the whole description.
HELP
}

#--#

sub parse_arguments
{
my (@arguments) = @_ ;

my %options = (command => []) ;

while (@arguments)
	{
	my $argument = $arguments[0] ;
	
	if ($argument eq '--')
		{
		shift @arguments ;
		
		$options{command} = [ @arguments ] ;
		
		last ;
		}
	
	if ($argument eq '-h')
		{
		shift @arguments ;
		
		$options{help} = 1 ;
		
		next ;
		}
	
	if ($argument !~ /\A--./)
		{
		$options{command} = [ @arguments ] ;
		
		last ;
		}
	
	shift @arguments ;
	
	my ($name, $value) = $argument =~ /\A(--[^=]+)(?:=(.*))?\z/s ;
	
	if (exists $FLAG_OPTION{$name})
		{
		die "option '$name' takes no value\n" if defined $value ;
		
		$options{$FLAG_OPTION{$name}} = 1 ;
		
		next ;
		}
	
	die "unknown option '$name'\n" unless exists $VALUE_OPTION{$name} || exists $COMMAND_OPTION{$name} ;
	
	$value = shift @arguments if !defined $value && @arguments ;
	
	die "option '$name' needs a value\n" unless defined $value ;
	
	if (exists $COMMAND_OPTION{$name})
		{
		die "option '$name': the value cannot contain a line end, write \\n\n" if $value =~ /[\r\n]/ ;
		
		my $command = eval { scalar KeyFilter::Command::parse_command("$COMMAND_OPTION{$name} $value") ; } ;
		
		if ($@)
			{
			(my $message = $@) =~ s/\n\z// ;
			
			die "option '$name': $message\n" ;
			}
		
		die "option '$name' needs a value\n" unless $command ;
		
		push @{$options{commands}}, $command ;
		}
	elsif ($name eq '--profile')
		{
		die "option '--profile' needs a value\n" unless length $value ;
		
		push @{$options{profiles}}, $value ;
		}
	else
		{
		$options{$VALUE_OPTION{$name}} = $value ;
		}
	}

return \%options if $options{help} || $options{version} ;

if ($options{discover})
	{
	die "--discover cannot be used with other options or a command\n" if @{$options{command}} || grep { $_ ne 'discover' && $_ ne 'command' } keys %options ;
	}

die "--fast can only be used with --replay\n" if $options{fast} && !defined $options{replay} ;

if (defined $options{replay})
	{
	die "--replay does not run a command\n" if @{$options{command}} ;
	die "--replay cannot be used with --record\n" if defined $options{record} ;
	die "--replay cannot be used with rules, profiles or startup options\n" if $options{profiles} || $options{commands} || $options{no_socket} ;
	}

return \%options ;
}

#--#

sub control_for
{
my ($options, $profiles) = @_ ;

my %info =
	(
	command  => join(' ', @{$options->{command}}),
	started  => time,
	profiles => join(' ', map { $_->name() } @$profiles),
	) ;

my $control = eval { KeyFilter::Control->new(info => \%info) ; } ;

if (!$control)
	{
	(my $message = $@) =~ s/\n\z// ;
	
	print STDERR "keyfilter: no control socket: $message\n" ;
	}

return $control ;
}

#--#

sub run_command
{
my ($options) = @_ ;

my @profiles = KeyFilter::Profile::load_profiles(@{$options->{profiles} // []}) ;
my $chain    = KeyFilter::Chain->new(profiles => \@profiles, command_line => $options->{commands} // []) ;

my %arguments = (command => $options->{command}, chain => $chain, startup => $chain->startup()) ;

$arguments{recorder} = KeyFilter::Recorder->new(file => $options->{record}) if defined $options->{record} ;
$arguments{control}  = control_for($options, \@profiles) unless $options->{no_socket} ;

return KeyFilter::PTY->new(%arguments)->run() ;
}

#--#

sub wants_help
{
my (@arguments) = @_ ;

while (@arguments)
	{
	my $argument = shift @arguments ;
	
	return 0 if $argument eq '--' || $argument !~ /\A-/ ;
	
	return 1 if $argument eq '-h' || $argument eq '--help' ;
	
	shift @arguments if exists $VALUE_OPTION{$argument} || exists $COMMAND_OPTION{$argument} ;
	}

return 0 ;
}

#--#

sub main
{
my (@arguments) = @_ ;

return KeyFilter::Ctl::run(argv => \@arguments) if File::Basename::basename($0) eq 'keyfilterctl' ;

if (wants_help(@arguments))
	{
	print help_text() ;
	
	return 0 ;
	}

my $options = eval { parse_arguments(@arguments) ; } ;

if (!$options)
	{
	print STDERR "keyfilter: $@" ;
	
	return 1 ;
	}

if ($options->{version})
	{
	print "keyfilter $VERSION\n" ;
	
	return 0 ;
	}

return KeyFilter::Discovery::run() if $options->{discover} ;

if (defined $options->{replay})
	{
	my $code = eval { KeyFilter::Replayer->new(file => $options->{replay}, fast => $options->{fast})->run() ; } ;
	
	return $code if defined $code ;
	
	print STDERR "keyfilter: $@" ;
	
	return 255 ;
	}

if (!@{$options->{command}})
	{
	print STDERR usage() ;
	
	return 1 ;
	}

my $code = eval { run_command($options) ; } ;

if (!defined $code)
	{
	print STDERR "keyfilter: $@" ;
	
	return 255 ;
	}

return $code ;
}

# -----------------------------------------------------------------------------

exit KeyFilter::CLI::main(@ARGV) unless caller ;

1 ;
