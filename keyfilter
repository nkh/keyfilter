#!/usr/bin/env perl

use strict ;
use warnings ;

# -----------------------------------------------------------------------------

package KeyFilter::Key ;

our $VERSION = '0.01' ;

my %SIMPLE =
	(
	Enter     => "\r",
	Return    => "\r",
	Tab       => "\t",
	Esc       => "\e",
	Escape    => "\e",
	Space     => ' ',
	Backspace => "\x7f",
	) ;

my %SPECIAL =
	(
	Up       => ['csi', 'A'],
	Down     => ['csi', 'B'],
	Right    => ['csi', 'C'],
	Left     => ['csi', 'D'],
	Home     => ['csi', 'H'],
	End      => ['csi', 'F'],
	Insert   => ['tilde', 2],
	Delete   => ['tilde', 3],
	PgUp     => ['tilde', 5],
	PgDn     => ['tilde', 6],
	PageUp   => ['tilde', 5],
	PageDown => ['tilde', 6],
	F1       => ['ss3', 'P'],
	F2       => ['ss3', 'Q'],
	F3       => ['ss3', 'R'],
	F4       => ['ss3', 'S'],
	F5       => ['tilde', 15],
	F6       => ['tilde', 17],
	F7       => ['tilde', 18],
	F8       => ['tilde', 19],
	F9       => ['tilde', 20],
	F10      => ['tilde', 21],
	F11      => ['tilde', 23],
	F12      => ['tilde', 24],
	) ;

my %MODIFIER_BIT =
	(
	S => 1,
	M => 2,
	C => 4,
	) ;

my %NAME_OF ;

# -----------------------------------------------------------------------------

sub parse_key_specs
{
my ($text) = @_ ;

return map { parse_key($_) } split(' ', $text) ;
}

# -----------------------------------------------------------------------------

sub parse_key
{
my ($spec) = @_ ;

$spec =~ s/\\#/#/g ;

my ($modifiers, $base) = split_modifiers($spec) ;

return char_sequence($modifiers, $base, $spec) if $base =~ /\A[\x21-\x7e]\z/ ;

return simple_sequence($modifiers, $base, $spec) if exists $SIMPLE{$base} ;

return special_sequence($modifiers, $base) if exists $SPECIAL{$base} ;

my $raw = %$modifiers ? undef : raw_sequence($base) ;

return $raw if defined $raw ;

die "unknown key specification '$spec'\n" ;
}

# -----------------------------------------------------------------------------

sub control_char
{
my ($char, $spec) = @_ ;

return "\x7f" if $char eq '?' ;

return chr(ord(uc $char) & 0x1f) if $char =~ /[A-Za-z\@\[\\\]^_]/ ;

die "key specification '$spec' has no control character\n" ;
}

# -----------------------------------------------------------------------------

sub raw_sequence
{
my ($spec) = @_ ;

return pack('H*', $spec) if $spec =~ /\A(?:[0-9a-fA-F]{2})+\z/ ;

return join('', map { chr hex $_ } $spec =~ /\\x([0-9a-fA-F]{2})/g) if $spec =~ /\A(?:\\x[0-9a-fA-F]{2})+\z/ ;

return ;
}

# -----------------------------------------------------------------------------

sub split_modifiers
{
my ($spec) = @_ ;

my ($prefix, $base) = $spec =~ /\A((?:[CMS]-)*)(.+)\z/ ;

($prefix, $base) = ('', $spec) unless defined $base ;

my %modifiers ;

for my $letter ($prefix =~ /([CMS])-/g)
	{
	die "duplicate modifier '$letter' in key specification '$spec'\n" if $modifiers{$letter}++ ;
	}

return (\%modifiers, $base) ;
}

# -----------------------------------------------------------------------------

sub char_sequence
{
my ($modifiers, $char, $spec) = @_ ;

if ($modifiers->{S})
	{
	die "modifier S needs a letter in key specification '$spec'\n" unless $char =~ /[A-Za-z]/ ;
	
	$char = uc $char ;
	}

$char = control_char($char, $spec) if $modifiers->{C} ;

return $modifiers->{M} ? "\e$char" : $char ;
}

# -----------------------------------------------------------------------------

sub simple_sequence
{
my ($modifiers, $name, $spec) = @_ ;

my %remaining = %$modifiers ;
my $sequence  = $SIMPLE{$name} ;

$sequence = "\e[Z" if $name eq 'Tab' && delete $remaining{S} ;
$sequence = "\x00" if $name eq 'Space' && delete $remaining{C} ;

my $meta          = delete $remaining{M} ;
my ($unsupported) = sort keys %remaining ;

die "modifier $unsupported is not supported for key specification '$spec', use a raw sequence\n" if $unsupported ;

return $meta ? "\e$sequence" : $sequence ;
}

# -----------------------------------------------------------------------------

sub special_sequence
{
my ($modifiers, $name) = @_ ;

my ($kind, $code) = @{$SPECIAL{$name}} ;
my $parameter     = 1 ;

$parameter += $MODIFIER_BIT{$_} for keys %$modifiers ;

if ($kind eq 'tilde')
	{
	return $parameter == 1 ? "\e[$code~" : "\e[$code;$parameter~" ;
	}

if ($kind eq 'ss3')
	{
	return $parameter == 1 ? "\eO$code" : "\e[1;$parameter$code" ;
	}

return $parameter == 1 ? "\e[$code" : "\e[1;$parameter$code" ;
}

# -----------------------------------------------------------------------------

sub utf8_length
{
my ($buffer) = @_ ;

return 0 unless length $buffer ;

my $lead = ord substr($buffer, 0, 1) ;
my $need = $lead >= 0xf0 && $lead <= 0xf4 ? 4 : $lead >= 0xe0 && $lead <= 0xef ? 3 : $lead >= 0xc2 && $lead <= 0xdf ? 2 : 1 ;

return 1 if $need == 1 ;

my $have  = length $buffer ;
my $check = $have < $need ? $have : $need ;

for my $index (1 .. $check - 1)
	{
	return 1 unless (ord(substr($buffer, $index, 1)) & 0xc0) == 0x80 ;
	}

return $have < $need ? 0 : $need ;
}

# -----------------------------------------------------------------------------

sub csi_length
{
my ($buffer) = @_ ;

my $length = length $buffer ;
my $index  = 2 ;

$index++ while $index < $length && ord(substr($buffer, $index, 1)) >= 0x30 && ord(substr($buffer, $index, 1)) <= 0x3f ;
$index++ while $index < $length && ord(substr($buffer, $index, 1)) >= 0x20 && ord(substr($buffer, $index, 1)) <= 0x2f ;

return 0 if $index >= $length ;

my $final = ord substr($buffer, $index, 1) ;

return $final >= 0x40 && $final <= 0x7e ? $index + 1 : 1 ;
}

# -----------------------------------------------------------------------------

sub key_length
{
my ($buffer) = @_ ;

return 0 unless length $buffer ;

return utf8_length($buffer) unless substr($buffer, 0, 1) eq "\e" ;

return 0 if length $buffer == 1 ;

my $second = substr($buffer, 1, 1) ;

return csi_length($buffer) if $second eq '[' ;

return length $buffer < 3 ? 0 : 3 if $second eq 'O' ;

if ($second eq "\e")
	{
	return 0 if length $buffer == 2 ;
	
	my $third = substr($buffer, 2, 1) ;
	
	return 2 unless $third eq '[' || $third eq 'O' ;
	
	my $inner = key_length(substr($buffer, 1)) ;
	
	return $inner ? 1 + $inner : 0 ;
	}

my $inner = utf8_length(substr($buffer, 1)) ;

return $inner ? 1 + $inner : 0 ;
}

# -----------------------------------------------------------------------------

sub split_keys
{
my ($buffer) = @_ ;

my @keys ;

while (length $buffer)
	{
	my $length = key_length($buffer) ;
	
	last unless $length ;
	
	push @keys, substr($buffer, 0, $length, '') ;
	}

return (\@keys, $buffer) ;
}

# -----------------------------------------------------------------------------

sub flush_keys
{
my ($remainder) = @_ ;

return length $remainder ? ($remainder) : () ;
}

# -----------------------------------------------------------------------------

sub candidate_specs
{
my @specs ;
my @printable = map { chr } 0x21 .. 0x7e ;
my @letters   = ('a' .. 'z') ;
my @simple    = ('Space', 'Enter', 'Tab', 'Esc', 'Backspace') ;
my @special   = (sort(grep { /\A(?:Up|Down|Right|Left|Home|End|Insert|Delete|PgUp|PgDn)\z/ } keys %SPECIAL), map { "F$_" } 1 .. 12) ;
my $escape    = sub { return $_[0] eq '#' ? '\#' : $_[0] ; } ;

push @specs, map { $escape->($_) } @printable ;
push @specs, @simple ;
push @specs, map { "C-$_" } @letters, 'Space', '\\', ']', '^', '_', '@', '[', '?' ;
push @specs, @special ;

for my $mask (1 .. 7)
	{
	my $prefix = join('', ($mask & 4 ? 'C-' : ''), ($mask & 2 ? 'M-' : ''), ($mask & 1 ? 'S-' : '')) ;
	
	push @specs, map { "$prefix$_" } @special ;
	}

push @specs, 'S-Tab', 'M-Enter', 'M-Tab', 'M-Esc', 'M-Space', 'M-Backspace', 'C-M-Space', 'M-S-Tab' ;
push @specs, map { 'M-' . $escape->($_) } @printable ;
push @specs, map { "C-M-$_" } @letters, '\\', ']', '^', '_' ;

return @specs ;
}

# -----------------------------------------------------------------------------

sub name_of
{
my ($sequence) = @_ ;

if (!%NAME_OF)
	{
	for my $spec (candidate_specs())
		{
		my $found = eval { parse_key($spec) ; } ;
		
		$NAME_OF{$found} //= $spec if defined $found ;
		}
	}

return $NAME_OF{$sequence} ;
}

# -----------------------------------------------------------------------------

package KeyFilter::Replacement ;

our $VERSION = '0.01' ;

my %ESCAPE =
	(
	n    => "\n",
	r    => "\r",
	t    => "\t",
	e    => "\e",
	'\\' => '\\',
	'<'  => '<',
	'#'  => '#',
	) ;

# -----------------------------------------------------------------------------

sub parse_replacement
{
my ($text) = @_ ;

my $original = $text ;
my $output   = '' ;

while (length $text)
	{
	if ($text =~ s/\A<<(.*?)>>//s)
		{
		$output .= KeyFilter::Key::parse_key($1) ;
		}
	elsif ($text =~ s/\A<<//)
		{
		die "unterminated key symbol in replacement '$original'\n" ;
		}
	elsif ($text =~ s/\A\\x([0-9a-fA-F]{2})//)
		{
		$output .= chr hex $1 ;
		}
	elsif ($text =~ s/\A\\(.)//s)
		{
		$output .= escape_char($1, $original) ;
		}
	elsif ($text =~ s/\A\\\z//)
		{
		die "trailing backslash in replacement '$original'\n" ;
		}
	else
		{
		$text =~ s/\A(.)//s ;
		$output .= $1 ;
		}
	}

return $output ;
}

# -----------------------------------------------------------------------------

sub escape_char
{
my ($char, $original) = @_ ;

return $ESCAPE{$char} if exists $ESCAPE{$char} ;

die "unknown escape '\\$char' in replacement '$original'\n" ;
}

# -----------------------------------------------------------------------------

package KeyFilter::Command ;

our $VERSION = '0.01' ;

my %PARSER =
	(
	block           => \&parse_key_command,
	unblock         => \&parse_key_command,
	map             => \&parse_map,
	toggle          => \&parse_name_command,
	include         => \&parse_name_command,
	profile         => \&parse_name_command,
	'startup-delay' => \&parse_startup_delay,
	'send-startup'  => \&parse_text_command,
	send            => \&parse_text_command,
	) ;

my %ARGUMENT_FIELD =
	(
	toggle  => 'profile',
	include => 'file',
	profile => 'profile',
	) ;

# -----------------------------------------------------------------------------

sub parse_command
{
my ($line) = @_ ;

$line =~ s/\r?\n\z// ;

$line = strip_comment($line) ;

return if $line =~ /\A\s*\z/ ;

my ($name, $argument) = $line =~ /\A\s*(\S+)(?:\s+(.*))?\z/ ;

$argument //= '' ;

my $parser = $PARSER{$name} or die "unknown command '$name'\n" ;

return $parser->($name, $argument) ;
}

# -----------------------------------------------------------------------------

sub strip_comment
{
my ($line) = @_ ;

return $line unless $line =~ /\A((?:[^\\#]|\\.)*)#/ ;

my $code = $1 ;

$code =~ s/\s+\z// ;

return $code ;
}

# -----------------------------------------------------------------------------

sub parse_key_command
{
my ($name, $argument) = @_ ;

my @keys = KeyFilter::Key::parse_key_specs($argument) ;

die "$name requires at least one key specification\n" unless @keys ;

return { cmd => $name, keys => \@keys } ;
}

# -----------------------------------------------------------------------------

sub parse_map
{
my ($name, $argument) = @_ ;

my ($trigger, $replacement) = $argument =~ /\A(\S+?)=(.*)\z/ ;

die "invalid syntax, expected: map KEY=REPLACEMENT\n" unless defined $trigger ;

return
	{
	cmd         => 'map',
	key         => KeyFilter::Key::parse_key($trigger),
	replacement => KeyFilter::Replacement::parse_replacement($replacement),
	} ;
}

# -----------------------------------------------------------------------------

sub parse_name_command
{
my ($name, $argument) = @_ ;

$argument =~ s/\s+\z// ;

die "$name requires an argument\n" if $argument eq '' ;

return { cmd => $name, $ARGUMENT_FIELD{$name} => $argument } ;
}

# -----------------------------------------------------------------------------

sub parse_startup_delay
{
my ($name, $argument) = @_ ;

$argument =~ s/\s+\z// ;

die "invalid duration '$argument', expected a number of milliseconds\n" unless $argument =~ /\A\d+\z/ ;

return { cmd => $name, ms => $argument + 0 } ;
}

# -----------------------------------------------------------------------------

sub parse_text_command
{
my ($name, $argument) = @_ ;

die "$name requires text\n" if $argument eq '' ;

return { cmd => $name, text => KeyFilter::Replacement::parse_replacement($argument) } ;
}

# -----------------------------------------------------------------------------

sub parse_commands
{
my ($text, $source) = @_ ;

my @commands ;
my $number = 0 ;

for my $line (split /\n/, $text)
	{
	$number++ ;
	
	$line =~ s/\r\z// ;
	
	my $command = eval { scalar parse_command($line) ; } ;
	
	die "$source:$number: $@" if $@ ;
	
	next unless $command ;
	
	$command->{source} = "$source:$number" ;
	
	push @commands, $command ;
	}

return @commands ;
}

# -----------------------------------------------------------------------------

package KeyFilter::Rules ;

our $VERSION = '0.01' ;

my %RULE_COMMAND =
	(
	block   => 1,
	unblock => 1,
	map     => 1,
	) ;

# -----------------------------------------------------------------------------

sub new
{
my ($class) = @_ ;

return bless { rules => [], index => undef }, $class ;
}

# -----------------------------------------------------------------------------

sub is_rule_command
{
my ($command) = @_ ;

return ref($command) eq 'HASH' && exists $RULE_COMMAND{$command->{cmd} // ''} ;
}

# -----------------------------------------------------------------------------

sub add
{
my ($self, $command) = @_ ;

unless (is_rule_command($command))
	{
	my $name = ref($command) eq 'HASH' ? ($command->{cmd} // '') : '' ;
	
	die "not a rule command '$name'\n" ;
	}

push @{$self->{rules}}, $command ;

$self->{index} = undef ;

return $self ;
}

# -----------------------------------------------------------------------------

sub rules { return @{$_[0]->{rules}} ; }

# -----------------------------------------------------------------------------

sub count { return scalar @{$_[0]->{rules}} ; }

# -----------------------------------------------------------------------------

sub clear
{
my ($self) = @_ ;

$self->{rules} = [] ;
$self->{index} = undef ;

return $self ;
}

# -----------------------------------------------------------------------------

sub matches
{
my ($rule, $key) = @_ ;

return $rule->{key} eq $key if $rule->{cmd} eq 'map' ;

return scalar grep { $_ eq $key } @{$rule->{keys}} ;
}

# -----------------------------------------------------------------------------

sub build_index
{
my ($self) = @_ ;

my %index ;

for my $rule ($self->rules())
	{
	my %seen ;
	
	for my $key ($rule->{cmd} eq 'map' ? ($rule->{key}) : @{$rule->{keys}})
		{
		push @{$index{$key}}, $rule unless $seen{$key}++ ;
		}
	}

return \%index ;
}

#--#

sub matching_rules
{
my ($self, $key) = @_ ;

$self->{index} //= $self->build_index() ;

return @{$self->{index}{$key} // []} ;
}

# -----------------------------------------------------------------------------

sub evaluate
{
my ($self, $key) = @_ ;

my %state = (blocked => 0, replacement => undef) ;

for my $rule ($self->matching_rules($key))
	{
	if ($rule->{cmd} eq 'map')
		{
		$state{replacement} = $rule->{replacement} ;
		}
	else
		{
		$state{blocked} = $rule->{cmd} eq 'block' ? 1 : 0 ;
		}
	}

return \%state ;
}

# -----------------------------------------------------------------------------

sub process
{
my ($self, $key) = @_ ;

my $state = $self->evaluate($key) ;

return '' if $state->{blocked} ;

return defined $state->{replacement} ? $state->{replacement} : $key ;
}

# -----------------------------------------------------------------------------

sub process_keys
{
my ($self, @keys) = @_ ;

return join('', map { $self->process($_) } @keys) ;
}

# -----------------------------------------------------------------------------

sub add_commands
{
my ($self, @commands) = @_ ;

for my $command (grep { is_rule_command($_) } @commands)
	{
	$self->add($command) ;
	}

return $self ;
}

